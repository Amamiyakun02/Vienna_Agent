# Salin ke .env untuk lokal. Di FastAPI Cloud / Railway / Render:
# isi SEMUA nilai ini via dashboard Environment Variables (jangan commit .env).
# Kosongkan yang tidak dipakai — kode sudah fail-open untuk layanan opsional.

# --- MongoDB (wajib: session & memory) ---
MONGO_USER=
MONGO_PASS=
MONGO_DB_NAME=

# --- Qdrant vector DB (wajib untuk RAG; retrieval fail-open bila mati) ---
# Lokal tanpa auth: QDRANT_URL=http://localhost:6333 dan QDRANT_API_KEY boleh kosong.
# Cloud (mis. Qdrant Cloud): isi URL https + API key.
QDRANT_URL=
QDRANT_API_KEY=

# --- Redis (wajib untuk rate-limit & relay device; fail-open bila mati) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# --- Supabase (opsional) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# --- Downloader cookies (opsional, format Netscape cookies.txt) ---
# Wajib via env di cloud (filesystem ephemeral). Lokal boleh pakai file
# data/cookies/<platform>.txt. Ekspor via ekstensi "Get cookies.txt".
YOUTUBE_COOKIES=
INSTAGRAM_COOKIES=
THREADS_COOKIES=
FACEBOOK_COOKIES=

# --- Downloader network (opsional) ---
# Proxy untuk konten yang diblokir di region server cloud, mis. VPS Indonesia.
# Contoh: "http://user:pass@103.x.x.x:8080" atau "socks5://127.0.0.1:1080".
DOWNLOADER_PROXY=

# --- WhatsApp gateway Fonnte (opsional) ---
WHATSAPP_GATEWAY_TOKEN=

# --- GitHub sync (opsional) ---
GITHUB_USERNAME=
GITHUB_TOKEN=

# --- LLM keys ---
# Gemini dipakai utama (wajib).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_CHAT_FALLBACK_MODEL=
# Embedding RAG: text-embedding-004 (768-dim), satu key dengan chat di atas.
# SYARAT: key TANPA API restriction untuk method EmbedContent (cek GCP
# console → APIs & Services → Credentials → klik key → API restrictions).
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMB_COOLDOWN_S=
# OpenAI hanya fallback/zaman dulu (opsional).
OPENAI_API_KEY=
OPENAI_EMB_COOLDOWN_S=
# RAG retrieval: "gemini" (default, gratis) atau "openai" (butuh credits).
# Ganti provider = koleksi Qdrant di-recreate otomatis + wajib re-ingest dokumen.
EMBEDDING_PROVIDER=gemini
EMBEDDING_COOLDOWN_S=

# --- Inception Labs Mercury (opsional; alternatif chat Gemini) ---
# API key: https://platform.inceptionlabs.ai/dashboard/api-keys
# MERCURY_API_KEY diutamakan; INCEPTION_API_KEY juga dibaca (nama resmi SDK).
# API OpenAI-compatible, jadi tidak butuh package tambahan.
MERCURY_API_KEY=
INCEPTION_API_KEY=
MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_MODEL=mercury-3
MERCURY_FALLBACK_MODEL=mercury-2.5
# instant | low | medium | high (mercury-3 default provider: low)
MERCURY_REASONING_EFFORT=low
# Provider hanya menerima 0.5–1.0 (di luar itu di-clamp oleh kode)
MERCURY_TEMPERATURE=0.75
MERCURY_MAX_COMPLETION_TOKENS=8192
MERCURY_TIMEOUT_S=120
# Batas putaran tool-call agar agent tidak looping
MERCURY_MAX_STEPS=8
# 1 = teruskan ringkasan reasoning ke client (field "reasoning", default mati)
MERCURY_STREAM_REASONING=0

# --- DeepSeek via LARP Router (opsional) ---
# API OpenAI-compatible: https://larprouter.com/v1
LARPROUTER_API_KEY=
LARPROUTER_BASE_URL=https://larprouter.com/v1
LARPROUTER_MODEL=deepseek-v4.1-flash
LARPROUTER_FALLBACK_MODEL=
LARPROUTER_MAX_COMPLETION_TOKENS=8192
LARPROUTER_TIMEOUT_S=120
LARPROUTER_MAX_STEPS=8
LARPROUTER_TEMPERATURE=0.75

# --- Auth (WAJIB ganti di production!) ---
JWT_SECRET=change-me-in-production-min-32-chars
GOOGLE_CLIENT_ID=

# --- Firebase / FCM (opsional; atau isi FIREBASE_CREDENTIALS_JSON) ---
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# --- MCP tools (opsional; server tools eksternal) ---
MCP_URL=

# --- Spotify (opsional) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# --- Runtime / tuning (semua ada default di kode) ---
# PORT diisi otomatis oleh platform (FastAPI Cloud/Railway/Render).
PORT=8000
# CORS: koma-separated origins tambahan, mis. "https://app-kamu.vercel.app"
CORS_ALLOW_ORIGINS=
# Ephemeral di cloud! Arahkan ke volume persisten bila perlu cache awet.
DATA_DIR=./data
DOWNLOADER_COOKIES_DIR=
# Budget & limit chat
USER_INPUT_MAX_CHARS=4000
CHAT_RL_PER_MIN=20
CHAT_RL_PER_DAY=150
HISTORY_MSG_LIMIT=12
HISTORY_PER_MSG_CHARS=1500
HISTORY_TOTAL_CHARS=12000
MAX_MSGS_PER_SESSION=
SESSION_IDLE_DAYS=
SUMMARY_EVERY_MSGS=
SUMMARY_MODEL=
SUMMARY_FALLBACK_MODEL=
SUMMARY_MAX_CHARS=

# OpenCode serve (core agentic backend)
OPENCODE_BASE_URL=
OPENCODE_SERVER_PASSWORD=
OPENCODE_AGENT=
OPENCODE_MODEL=
OPENCODE_TIMEOUT_S=

# Dua instance opencode-core (publik & admin). Role admin di router
# WAJIB membawa token dashboard (X-Admin-Token) — tanpa itu 401.
# Publik default http://127.0.0.1:4097; admin default OPENCODE_BASE_URL
# (4096). Di LAPTOP port 4096 ditempati serve pribadi, jadi arahkan
# admin ke instance ~/start-opencode-admin.sh: http://127.0.0.1:4098
OPENCODE_PUBLIC_BASE_URL=
OPENCODE_ADMIN_BASE_URL=

# --- API key platform lain untuk opencode serve (core agentic) ---
# Isi di .env lalu jalankan ulang ~/start-opencode-serve.sh.
# OPENAI_API_KEY & GEMINI_API_KEY sudah ada di bagian lain file ini;
# GEMINI_API_KEY otomatis dipakai juga sebagai GOOGLE_GENERATIVE_AI_API_KEY.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
LYBER_API_KEY=
LYBER_BASE_URL=
LYBER_MODEL=
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=
AGENTROUTER_MODEL=

# Limit role publik opencode — menahan pemborosan token (kosong = default
# kode: prompt 4000 karakter, 30 giliran/sesi, 250000 token/sesi, 80000
# token/giliran; isi 0 untuk menonaktifkan satu limit)
OPENCODE_PUBLIC_MAX_PROMPT_CHARS=
OPENCODE_PUBLIC_MAX_TURNS=
OPENCODE_PUBLIC_MAX_SESSION_TOKENS=
OPENCODE_PUBLIC_MAX_TURN_TOKENS=

# Direktori instance publik opencode (salinan live config) — diisi agar
# publish dashboard juga menulis config live, bukan hanya repo.
# Laptop: /home/amamiya/agent-public | VPS: /home/amamiya/apps/agent-public
OPENCODE_PUBLIC_DIR=

# Direktori kerja instance admin opencode — backend membaca dari sini
# file yang dibuat/diubah agent admin untuk dikembalikan sebagai
# lampiran "files" di akhir giliran chat. Kosong = folder
# admin-workspace/ di repo backend (di compose VPS diisi /app/admin-workspace).
OPENCODE_ADMIN_DIR=
INCEPTIONLAB_API_KEY=

# Docker Compose (container postgres) — password WAJIB URL-safe
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=

# System Dashboard (login admin + database PostgreSQL)
# Di Docker Compose, DATABASE_URL DIRAKIT OTOMATIS dari POSTGRES_* di bawah
# (blok ini hanya untuk jalan bare-metal di luar container).
DASHBOARD_ADMIN_USER=
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_SECRET_KEY=
DATABASE_URL=
