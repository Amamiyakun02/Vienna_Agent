# Salin ke .env untuk lokal. Di FastAPI Cloud / Railway / Render:
# isi SEMUA nilai ini via dashboard Environment Variables (jangan commit .env).
# Kosongkan yang tidak dipakai — kode sudah fail-open untuk layanan opsional.

# --- MongoDB (wajib: session & memory) ---
MONGO_USER=
MONGO_PASS=
MONGO_DB_NAME=

# --- Qdrant vector DB (wajib untuk RAG; retrieval fail-open bila mati) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Redis (wajib untuk rate-limit & relay device; fail-open bila mati) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# --- Supabase (opsional) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# --- Downloader cookies (opsional, format Netscape cookies.txt) ---
# Wajib via env di cloud (filesystem ephemeral). Lokal boleh pakai file
# data/cookies/<platform>.txt. Ekspor via ekstensi "Get cookies.txt".
YOUTUBE_COOKIES=
INSTAGRAM_COOKIES=
THREADS_COOKIES=
FACEBOOK_COOKIES=

# --- Downloader network (opsional) ---
# Proxy untuk konten yang diblokir di region server cloud, mis. VPS Indonesia.
# Contoh: "http://user:pass@103.x.x.x:8080" atau "socks5://127.0.0.1:1080".
DOWNLOADER_PROXY=

# --- WhatsApp gateway Fonnte (opsional) ---
WHATSAPP_GATEWAY_TOKEN=

# --- GitHub sync (opsional) ---
GITHUB_USERNAME=
GITHUB_TOKEN=

# --- LLM keys ---
# Gemini dipakai utama (wajib).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_CHAT_FALLBACK_MODEL=
# Embedding RAG: text-embedding-004 (768-dim), satu key dengan chat di atas.
# SYARAT: key TANPA API restriction untuk method EmbedContent (cek GCP
# console → APIs & Services → Credentials → klik key → API restrictions).
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMB_COOLDOWN_S=
# OpenAI hanya fallback/zaman dulu (opsional).
OPENAI_API_KEY=
OPENAI_EMB_COOLDOWN_S=
# RAG retrieval: "gemini" (default, gratis) atau "openai" (butuh credits).
# Ganti provider = koleksi Qdrant di-recreate otomatis + wajib re-ingest dokumen.
EMBEDDING_PROVIDER=gemini
EMBEDDING_COOLDOWN_S=

# --- Auth (WAJIB ganti di production!) ---
JWT_SECRET=change-me-in-production-min-32-chars
GOOGLE_CLIENT_ID=

# --- Firebase / FCM (opsional; atau isi FIREBASE_CREDENTIALS_JSON) ---
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=

# --- MCP tools (opsional; server tools eksternal) ---
MCP_URL=

# --- Spotify (opsional) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# --- Runtime / tuning (semua ada default di kode) ---
# PORT diisi otomatis oleh platform (FastAPI Cloud/Railway/Render).
PORT=8000
# CORS: koma-separated origins tambahan, mis. "https://app-kamu.vercel.app"
CORS_ALLOW_ORIGINS=
# Ephemeral di cloud! Arahkan ke volume persisten bila perlu cache awet.
DATA_DIR=./data
DOWNLOADER_COOKIES_DIR=
# Budget & limit chat
USER_INPUT_MAX_CHARS=4000
CHAT_RL_PER_MIN=20
CHAT_RL_PER_DAY=150
HISTORY_MSG_LIMIT=12
HISTORY_PER_MSG_CHARS=1500
HISTORY_TOTAL_CHARS=12000
MAX_MSGS_PER_SESSION=
SESSION_IDLE_DAYS=
SUMMARY_EVERY_MSGS=
SUMMARY_MODEL=
SUMMARY_FALLBACK_MODEL=
SUMMARY_MAX_CHARS=
