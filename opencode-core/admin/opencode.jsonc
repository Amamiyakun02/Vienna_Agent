{
  "$schema": "https://opencode.ai/config.json",

  // ============================================================
  // INSTANCE ADMIN — lewat System Dashboard (sudah login; router
  // backend mewajibkan token dashboard untuk role ini). Serve
  // dijalankan opencode-core/start-admin.sh dari direktori kerja
  // KHUSUS <project>/admin-workspace dengan OPENCODE_CONFIG
  // menunjuk file ini: agent berakses penuh DI DALAM direktori
  // itu dan DITOLAK menyentuh sisa project (permission
  // external_directory: deny di bawah). Port default 4096 (VPS);
  // laptop 4098 lewat env OPENCODE_ADMIN_PORT (4096 ditempati
  // serve pribadi). Publish dashboard menulis blok providers +
  // model agent file ini — tidak ada salinan config kedua.
  // Approval & audit TIDAK di sini: itu gerbang dashboard/backend
  // SEBELUM prompt dikirim. Di serve headless jangan pakai "ask".
  // ============================================================

  "model": "lyber/kimi-k31-pro-abliterated",
  "default_agent": "admin",

  "providers": {
    "agentrouter": {
      "name": "AgentRouter",
      "env": [
        "AGENTROUTER_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai",
      "settings": {
        "baseURL": "https://agentrouter.org/v1"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "inception": {
      "name": "Inception Labs (Mercury)",
      "env": [
        "INCEPTION_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.inceptionlabs.ai/v1"
      },
      "models": {
        "mercury-3": {
          "name": "Mercury 3",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "lyber": {
      "name": "Lyber",
      "env": [
        "LYBER_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.lyber.ai/v1"
      },
      "models": {
        "kimi-k31-pro-abliterated": {
          "name": "Kimi K3.1 Pro Abliterated",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },

  "instructions": [".opencode/instructions/*.md"],

  "compaction": {
    "auto": true,
    "keep": { "tokens": 15000 },
    "buffer": "15%"
  },

  "tool_output": { "max_lines": 2000, "max_bytes": 51200 },

  "mcp": {
    "timeout": { "startup": 30000, "catalog": 30000, "execution": 600000 },
    "servers": {
      "vienna": {
        "type": "remote",
        "url": "http://127.0.0.1:8001/mcp",
        "oauth": false,
        "codemode": false
      }
    }
  },

  "agents": {
    "admin": {
      "description": "Agent administrator Amamiya via System Dashboard",
      "mode": "primary",
      "model": "lyber/kimi-k31-pro-abliterated",
      "steps": 30,
      "system": "Kamu adalah agent administrator untuk Amamiya, dijalankan lewat System Dashboard yang sudah ter-login. WILAYAH KERJAMU HANYA direktori kerja ini (admin-workspace di dalam project Vienna_Agent): di dalamnya kamu berakses penuh. Di luar direktori ini wilayah terlarang — jangan pernah membaca, mengubah, atau menghapus program lain di dalam project (backend, frontend, config) maupun file lain di mesin ini; tool file memang dikunci ke direktori ini. Wajib: jangan pernah membaca file .env atau menampilkan kredensial; untuk aksi destruktif (hapus data, deploy, restart service) sebutkan dulu di jawaban apa yang akan dilakukan dan tunggu perintah eksplisit di pesan berikutnya.",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "shell", "resource": "sudo *", "effect": "deny" }
      ]
    }
  }
}
