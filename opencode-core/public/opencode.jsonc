{
  "$schema": "https://opencode.ai/config.json",

  // ============================================================
  // INSTANCE PUBLIK — pengunjung portofolio (agent anonim)
  // Jalankan serve dari folder INI (workspace kosong/sandbox),
  // BUKAN dari folder Vienna_Agent. Lihat ../README.md.
  // Format V2 (serve di server v2.1.4, di laptop v2.2.2):
  // "agents" jamak, "mcp.servers", "permissions" berupa array.
  // Jangan pakai format V1 (agent/mcp langsung) — tidak terbaca.
  // ============================================================

  "model": "inception/mercury-3",
  "default_agent": "public",

  // --- Provider custom: Mercury & Lyber dua-duanya OpenAI-compatible,
  // jadi TIDAK perlu engine sendiri. Daftarkan sekali di sini,
  // key diambil dari env (file ini aman di-commit, key TIDAK di sini).
  "providers": {
    "agentrouter": {
      "name": "AgentRouter",
      "env": [
        "AGENTROUTER_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai",
      "settings": {
        "baseURL": "https://agentrouter.org/v1"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "inception": {
      "name": "Inception Labs (Mercury)",
      "env": [
        "INCEPTION_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.inceptionlabs.ai/v1"
      },
      "models": {
        "mercury-3": {
          "name": "Mercury 3",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "lyber": {
      "name": "Lyber",
      "env": [
        "LYBER_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.lyber.ai/v1"
      },
      "models": {
        "kimi-k31-pro-abliterated": {
          "name": "Kimi K3.1 Pro Abliterated",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },

  // --- Memory lapis 2 (statis): file instruksi ini dimuat ke SETIAP
  // sesi baru. Isinya profil Amamiya. Edit file-nya,
  // bukan kode backend, untuk mengubah "ingatan permanen" agent.
  "instructions": [".opencode/instructions/*.md"],

  // --- Memory lapis 1 (sesi): compaction bawaan opencode.
  // Riwayat sesi sendiri disimpan opencode di SQLite-nya
  // (~/.local/share/opencode/opencode.db, atau XDG_DATA_HOME bila
  // dipisah per instance — lihat start-public.sh). Backend hanya
  // menyimpan session_id, TIDAK menyimpan ulang riwayat chat.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 12000 },
    "buffer": "15%"
  },

  // Potong output tool raksasa sebelum masuk konteks = hemat memory.
  "tool_output": { "max_lines": 1000, "max_bytes": 30000 },

  // --- Tools: SEMUA tool eksternal dari MCP server milikmu sendiri.
  // Tambah/hapus tool = ubah MCP server / blok ini, bukan kode agent.
  "mcp": {
    "timeout": { "startup": 30000, "catalog": 30000, "execution": 120000 },
    "servers": {
      "vienna": {
        "type": "remote",
        "url": "http://127.0.0.1:8001/mcp",
        "oauth": false,
        // PENTING untuk agent publik: false = tool tampil langsung
        // satu-satu. Default V2 (true) membungkus tool MCP ke dalam
        // tool "execute" (eksekusi kode) — itu melanggar aturanmu
        // bahwa agent anonim tidak boleh mengeksekusi program.
        "codemode": false
        // Alternatif lokal (MCP tidak di-docker, jalan stdio):
        // "type": "local",
        // "command": ["uv", "run", "python", "mcp_server.py"],
        // "cwd": "../MCPServer"
      }
    }
  },

  "agents": {
    "public": {
      "description": "Agent anonim untuk pengunjung portofolio Amamiya",
      "mode": "primary",
      "model": "inception/mercury-3",
      "steps": 12,
      "temperature": 0.3,
      "system": "Kamu adalah Vienna, asisten di portofolio Amamiya (AI Application & Automation Engineer). Jawab soal Amamiya, proyek, dan keahliannya dari file instruksi. Boleh memakai tool MCP 'vienna' dan membuat file program sebagai ISI jawaban / file di folder output/. DILARANG menjalankan program apa pun.\n\nKepribadian (diadaptasi dari agent pribadi vienna): ramah, ringkas, objektif, berbahasa Indonesia (kecuali pengunjung memakai bahasa lain). Jawaban singkat dan padat, fokus pada fakta dan solusi, tanpa pemanis berlebihan, tanpa emoji kecuali diminta. Selesaikan lewat tindakan, bukan ceramah: bila diminta membuat sesuatu, langsung buat. Verifikasi hasil kerjamu sendiri bila memungkinkan dan wajar. Bila sesuatu tidak ada di instruksi maupun tool, katakan terus terang — jangan mengarang.\n\nBERTANYA: bila permintaan pengunjung belum jelas atau kurang spesifik (mis. 'buatkan program' tanpa tujuan), JANGAN bertanya lewat teks biasa — pakai tool question agar pengunjung menjawab lewat form. Satu form boleh berisi beberapa pertanyaan sekaligus, dan beri pilihan jawaban yang konkret bila memungkinkan.\n\nSESUDAH FORM DIJAWAB: lanjutkan tugas di giliran yang sama sampai selesai dan hasil akhirnya benar-benar ada (file terbuat/terubah, jawaban tuntas). JANGAN mengakhiri giliran hanya dengan pengumuman langkah berikutnya (mis. 'Aku cek dulu isi file X') tanpa melakukan langkah itu.\n\nFILE: bila kamu membuat atau mengubah file, sebutkan nama file-nya di akhir jawabanmu — isi file akan dilampirkan otomatis ke pengunjung oleh sistem.",
      // ATURAN HEADLESS: jangan pernah pakai effect "ask" di serve
      // yang dipanggil backend — tidak ada manusia di ujung serve,
      // request akan menggantung sampai timeout. Hanya allow/deny.
      // Urutan penting: aturan TERAKHIR yang cocok yang menang.
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "output/**", "effect": "allow" },
        // Edit/write boleh di SELURUH direktori kerja sandbox ini
        // (permintaan user 19 Nov: agent bisa mengubah file yang ada
        // di direktori kerjanya), KECUALI berkas kendali di bawah —
        // aturan terakhir yang cocok yang menang, jadi deny ditaruh
        // sesudah allow "**". Config yang bisa ditulis ulang agent =
        // jalur eskalasi (agent melonggarkan izinnya sendiri), maka
        // opencode.jsonc + .opencode/ + .data/ dikunci.
        { "action": "edit", "resource": "**", "effect": "allow" },
        { "action": "edit", "resource": "opencode.jsonc", "effect": "deny" },
        { "action": "edit", "resource": "opencode.jsonc.bak", "effect": "deny" },
        { "action": "edit", "resource": ".opencode/**", "effect": "deny" },
        { "action": "edit", "resource": ".data/**", "effect": "deny" },
        { "action": "edit", "resource": "*.env", "effect": "deny" },
        { "action": "edit", "resource": "*.env.*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        // Tool question = form HITL: tanpa allow ini agent tidak bisa
        // bertanya lewat form (form.created -> backend -> kartu di
        // frontend) dan terpaksa bertanya lewat teks biasa. Aman untuk
        // publik: form hanya menampilkan pertanyaan, bukan aksi.
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "vienna_*", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
